<Window x:Class="Lou.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LOU Control Center" Background="#0C1015" Foreground="#F2F5F7" FontFamily="Segoe UI" Width="1440" Height="950" MinWidth="1120" MinHeight="740" Icon="assets/lou.ico" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="68"/></Grid.RowDefinitions>
  <Border Background="#10161D" BorderBrush="#25303A" BorderThickness="0,0,0,1" Padding="30,0"><DockPanel VerticalAlignment="Center"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><TextBlock Text="LOU" FontSize="29" FontWeight="Bold"/><TextBlock Text=" / " Foreground="#68E4CF" FontSize="29"/><StackPanel Margin="8,3,0,0"><TextBlock Text="CONTROL CENTER" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Votre PC. Vos écrans." Foreground="#87949F" FontSize="11"/></StackPanel></StackPanel><TextBlock x:Name="HeaderStatus" Text="PORTABLE · 2.1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#87949F" FontSize="11"/></DockPanel></Border>
  <TabControl x:Name="Tabs" Grid.Row="1" Style="{StaticResource Navigation}">
   <TabItem Header="Vue d’ensemble" Style="{StaticResource NavigationItem}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Tout commence ici." Style="{StaticResource Title}"/><TextBlock Text="Vos informations en direct, sur les écrans de votre choix." Style="{StaticResource Subtitle}"/>
    <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="PRISE EN MAIN" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="SetupSummary" Margin="0,12,0,14"/><WrapPanel><Button Content="1 · Mes écrans" Click="GoScreens"/><Button Content="2 · Mes capteurs" Click="GoSensors"/><Button Content="3 · Ma ville" Click="GoWeather"/></WrapPanel></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="APERÇU EN DIRECT" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="PreviewTitle" HorizontalAlignment="Right" Foreground="#68E4CF"/></DockPanel><ComboBox x:Name="PreviewChoice" SelectionChanged="PreviewChanged"/><Border Background="#070D15" CornerRadius="10" Padding="5"><Image x:Name="Preview" MaxHeight="320" Stretch="Uniform"/></Border><TextBlock x:Name="PreviewStatus" Margin="0,12,0,0" Foreground="#87949F"/></StackPanel></Border>
    <UniformGrid Columns="3" Margin="0,20,0,0"><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="PROCESSEUR" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="CpuValue" FontSize="27" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="CARTE GRAPHIQUE" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="GpuValue" FontSize="27" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="POMPE" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="PumpValue" FontSize="27" Margin="0,10,0,0"/></StackPanel></Border></UniformGrid>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Écrans" Style="{StaticResource NavigationItem}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Un espace pour chaque écran." Style="{StaticResource Title}"/><TextBlock Text="Chaque écran dispose des cinq rubriques, avec une présentation adaptée à son format." Style="{StaticResource Subtitle}"/>
    <DockPanel><Button Content="Détecter les écrans" DockPanel.Dock="Right" Click="ScanClick"/><ComboBox x:Name="DisplayChoice" MinWidth="330" SelectionChanged="DisplayChanged"/></DockPanel>
    <TextBlock x:Name="EmptyScreens" Text="Branchez un écran Thermalright. La détection se relance automatiquement." Margin="0,8,0,18" Foreground="#87949F"/>
    <StackPanel x:Name="DisplayEditor" IsEnabled="False">
     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Cet écran" Style="{StaticResource SectionTitle}"/><TextBox x:Name="DisplayName" MaxLength="80"/><CheckBox x:Name="DisplayEnabled" Content="Afficher les informations sur cet écran"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Orientation"/><ComboBox x:Name="Rotation"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Cadence souhaitée (images/s)"/><TextBox x:Name="Fps"/></StackPanel></Grid><WrapPanel><Button Content="Afficher / arrêter la mire" Click="TestDisplay"/><Button Content="Réinitialiser la détection" Click="ResetDisplay"/></WrapPanel><TextBlock x:Name="DeviceInfo" Foreground="#87949F" FontSize="12"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Ce qui défile" Style="{StaticResource SectionTitle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Mode d’affichage"/><ComboBox x:Name="Mode"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Page du mode fixe"/><ComboBox x:Name="FixedPage"/></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Temps par page (secondes)"/><TextBox x:Name="Interval"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Transition"/><ComboBox x:Name="PageEffect"/></StackPanel></Grid><CheckBox x:Name="CoolingOnly" Content="Afficher uniquement la température CPU et le refroidissement"/><DataGrid x:Name="Pages" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Height="300" PreviewMouseWheel="ScrollPages"><DataGrid.Columns><DataGridTemplateColumn Header="Afficher" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Page" Binding="{Binding Name}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Ordre" Binding="{Binding Order,UpdateSourceTrigger=PropertyChanged}" Width="80"/><DataGridTemplateColumn Header="Masquer si indisponible" Width="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding HideUnavailable,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><Expander Header="Réglages avancés"><StackPanel><TextBlock Text="Durée de transition (secondes)"/><TextBox x:Name="TransitionTime"/><TextBlock Text="Qualité JPEG (70 à 95)"/><TextBox x:Name="Quality"/></StackPanel></Expander></StackPanel></Border>
    </StackPanel>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Capteurs" Style="{StaticResource NavigationItem}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Les bonnes mesures." Style="{StaticResource Title}"/><TextBlock Text="Associez chaque mesure au composant correspondant. Vos courbes de ventilation restent gérées par le BIOS et le pilote graphique." Style="{StaticResource Subtitle}"/>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock x:Name="SensorStatus" Margin="0,0,0,12"/><WrapPanel><Button x:Name="ActivateSensors" Content="Activer la lecture des capteurs" Click="StartSensors" Style="{StaticResource PrimaryButton}"/><Button Content="Actualiser la liste" Click="RefreshSensors"/></WrapPanel><TextBlock x:Name="SensorHelp" Text="Windows peut demander une autorisation administrateur. La collecte s’arrête à la fermeture de cette version portable." Foreground="#87949F" FontSize="12"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Températures et carte graphique" Style="{StaticResource SectionTitle}"/><TextBlock Text="Carte graphique surveillée"/><ComboBox x:Name="GpuChoice"/><TextBlock Text="Température du processeur"/><ComboBox x:Name="CpuTempChoice"/><TextBlock Text="Température de la carte graphique"/><ComboBox x:Name="GpuTempChoice"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Ventilateurs et pompe" Style="{StaticResource SectionTitle}"/><TextBlock Text="Une mesure par rôle. Les libellés sont libres ; aucun capteur n’est associé d’après sa vitesse." Foreground="#87949F" Margin="0,0,0,16"/><StackPanel x:Name="FanEditors"/><Expander Header="Inventaire et identifiants"><TextBox x:Name="SensorDetails" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="350" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/></Expander></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Météo" Style="{StaticResource NavigationItem}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Le temps, chez vous." Style="{StaticResource Title}"/><TextBlock Text="Choisissez votre ville. Aucun compte, aucune clé API." Style="{StaticResource Subtitle}"/>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Ville"/><DockPanel><Button Content="Rechercher" DockPanel.Dock="Right" Click="SearchCity" Margin="12,6,0,16"/><TextBox x:Name="CityQuery" MaxLength="120" KeyDown="CityKey"/></DockPanel><ComboBox x:Name="CityResults"/><Button Content="Choisir cette ville" Click="SelectCity" HorizontalAlignment="Left"/><TextBlock x:Name="CityStatus" Margin="0,12,0,0" Foreground="#68E4CF"/><TextBlock Text="Actualisation toutes les 20 minutes. La dernière météo connue est conservée en cas de coupure réseau." Margin="0,20,0,8" Foreground="#87949F"/><TextBlock Text="Données météo : Open-Meteo · CC BY 4.0. Recherche de villes : GeoNames via Open-Meteo. Accès gratuit pour un usage non commercial." Foreground="#87949F" FontSize="12"/></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Apparence" Style="{StaticResource NavigationItem}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="À votre image." Style="{StaticResource Title}"/><TextBlock Text="Un univers commun à vos écrans, des compositions adaptées à chacun." Style="{StaticResource Subtitle}"/>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Couleur d’accent"/><ComboBox x:Name="Accent"/><TextBlock Text="Intensité des lueurs"/><Slider x:Name="Glow" Minimum="0" Maximum="1" Margin="0,12,0,20"/><TextBlock Text="Animation des décors"/><Slider x:Name="Motion" Minimum="0" Maximum="1" Margin="0,12,0,20"/><CheckBox x:Name="Night" Content="Atténuer les écrans la nuit"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="À partir de (heure)"/><TextBox x:Name="NightStart"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Jusqu’à (heure)"/><TextBox x:Name="NightEnd"/></StackPanel></Grid></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Décors" Style="{StaticResource SectionTitle}"/><ComboBox x:Name="BackgroundPage"/><WrapPanel><Button Content="Choisir une image…" Click="ChooseBackground"/><Button Content="Rétablir le décor d’origine" Click="ResetBackground"/></WrapPanel><TextBlock x:Name="BackgroundInfo" Foreground="#87949F"/></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Réglages" Style="{StaticResource NavigationItem}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Simple, jusque dans les détails." Style="{StaticResource Title}"/><TextBlock Text="Vos réglages suivent le dossier de l’application." Style="{StaticResource Subtitle}"/>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Application" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="Tray" Content="Réduire dans la zone de notification à la fermeture"/><CheckBox x:Name="AutoFps" Content="Mesurer automatiquement les FPS des jeux"/><TextBlock Text="La détection des jeux utilise leur activité graphique. Les applications protégées peuvent limiter l’accès aux FPS. La taille affichée est celle de la fenêtre, pas la résolution interne de rendu." Foreground="#87949F" FontSize="12"/><Expander Header="Exceptions de détection des jeux"><StackPanel><TextBlock Text="Jeux à inclure (noms des exécutables, un par ligne)"/><TextBox x:Name="IncludedGames" AcceptsReturn="True" Height="85"/><TextBlock Text="Applications à ignorer (un par ligne)"/><TextBox x:Name="IgnoredGames" AcceptsReturn="True" Height="85"/></StackPanel></Expander><TextBlock Text="Interface réseau du PC (vide : automatique)" Margin="0,16,0,0"/><TextBox x:Name="Network"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Configuration" Style="{StaticResource SectionTitle}"/><WrapPanel><Button Content="Exporter…" Click="ExportConfig"/><Button Content="Importer…" Click="ImportConfig"/><Button Content="Ouvrir le dossier des données" Click="OpenData"/></WrapPanel><TextBlock x:Name="StorageHelp" Text="Cette version ne crée ni installation, ni démarrage automatique, ni service permanent. Le composant matériel PawnIO peut être nécessaire pour certains capteurs." Foreground="#87949F"/><Button Content="Quitter LOU Control Center" Click="Quit" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="#10161D" BorderBrush="#25303A" BorderThickness="0,1,0,0" Padding="26,12"><DockPanel><Button Content="Enregistrer et appliquer" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Click="Save" Margin="18,0,0,0"/><TextBlock x:Name="Status" Text="Bienvenue dans LOU Control Center." VerticalAlignment="Center" Foreground="#A3B2BE"/></DockPanel></Border>
 </Grid>
</Window>



